# Copy this file to .env and paste your real keys. Never commit .env.

# data.go.kr -> 마이페이지 -> 활용신청 현황 -> any approved API -> 일반 인증키 (Decoding)
# One key covers KMA 단기예보, AirKorea 대기오염정보, AirKorea 측정소정보.
DATA_GO_KR_KEY=

# data.seoul.go.kr -> 인증키 관리 -> 일반 인증키 -> 인증키 복사
# Use "sample" to test (max 5 rows per call).
# Optional: seconds to reuse a station's arrivals (default 30, 0 = off).
# SUBWAY_CACHE_SECONDS=30
SEOUL_API_KEY=sample

# Telegram: @BotFather -> /newbot -> copy the token.
# Then message your bot once and run: uv run -m briefing.main chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM writer (optional; `--writer llm`). Set ONE key. Falls back to rules if both empty.
# Gemini: aistudio.google.com -> Get API key (free tier, no card).
# Anthropic: console.anthropic.com -> API keys (prepaid credits).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: force a provider (anthropic|gemini) or override the model.
# LLM_PROVIDER=
# GEMINI_MODEL=gemini-3.8-flash,<backup model>   (comma list: next is tried on 503/429)
# ANTHROPIC_MODEL=claude-haiku-5-5
